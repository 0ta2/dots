#!/usr/bin/env bash
set -u

[[ "${1:-}" =~ ^0+$ && "${3:-}" == "1" ]] || exit 0

common=$(git rev-parse --path-format=absolute --git-common-dir) || exit 0
gitdir=$(git rev-parse --path-format=absolute --git-dir) || exit 0
[[ "$common" != "$gitdir" ]] || exit 0

src=$(cd "$(dirname "$common")" 2>/dev/null && pwd -P) || exit 0
[[ "$(git -C "$src" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" == "$common" ]] || exit 0

dest=$(pwd -P)
[[ "$src" != "$dest" ]] || exit 0

while IFS= read -r path; do
    [[ -n "$path" ]] || continue
    [[ "$path" != /* && "$path" != *..* ]] || continue
    [[ -e "$src/$path" ]] || continue
    [[ ! -e "$dest/$path" && ! -L "$dest/$path" ]] || continue

    parent="$dest/$(dirname "$path")"
    ancestor="$parent"
    while [[ ! -e "$ancestor" ]]; do ancestor=$(dirname "$ancestor"); done
    real=$(cd "$ancestor" && pwd -P) || continue
    [[ "$real" == "$dest" || "$real" == "$dest"/* ]] || continue

    mkdir -p "$parent"
    cp -R "$src/$path" "$dest/$path" || echo "git-worktree-copyfile: failed to copy $path" >&2
done < <(git config --get-all worktree.copyfile)
