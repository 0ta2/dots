#!/bin/bash

set -eu

{{ if eq .chezmoi.username "0ta2" }}
CONF=/etc/ssh/sshd_config.d/099-hardening.conf

DESIRED=$(cat <<'EOF'
PasswordAuthentication no
KbdInteractiveAuthentication no
PubkeyAuthentication yes
PermitRootLogin no
MaxAuthTries 3
AllowUsers {{ .chezmoi.username }}
EOF
)

# 鍵で入れない状態でパスワード認証を切ると締め出される。
# 非空チェックだけではコメント行のみのファイルを通してしまうため、
# ssh-keygen に実際にパースさせて有効な鍵の存在を確かめる。
if ! ssh-keygen -l -f "${HOME}/.ssh/authorized_keys" >/dev/null 2>&1; then
    echo "🔐 no usable public key in authorized_keys, skipping sshd hardening" >&2
    exit 0
fi

echo "🔐 Applying sshd hardening (sudo required)..."
TMP=$(mktemp)
printf '%s\n' "$DESIRED" >"$TMP"
sudo install -m 644 "$TMP" "$CONF"
rm -f "$TMP"

if ! sudo sshd -T >/dev/null; then
    echo "🔐 sshd config test failed, reverting" >&2
    sudo rm -f "$CONF"
    exit 1
fi

sudo launchctl kickstart -k system/com.openssh.sshd || echo "🔐 sshd is not running, config will apply when enabled"
echo "🔐 sshd hardening applied"
{{ end }}
