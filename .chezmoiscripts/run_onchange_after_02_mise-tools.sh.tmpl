#!/bin/bash

set -eu

# mise config hash: {{ include "dot_config/mise/config.toml" | sha256sum }}
# uv tools hash: {{ include "mise.toml" | sha256sum }}

if command -v mise >/dev/null 2>&1; then
    MISE_BIN=$(command -v mise)
elif [[ -x /opt/homebrew/bin/mise ]]; then
    MISE_BIN=/opt/homebrew/bin/mise
elif [[ -x /usr/local/bin/mise ]]; then
    MISE_BIN=/usr/local/bin/mise
else
    echo "mise is not installed" >&2
    exit 1
fi

SOURCE_DIR={{ .chezmoi.sourceDir | quote }}

"$MISE_BIN" --cd "$SOURCE_DIR" install --yes
"$MISE_BIN" --cd "$SOURCE_DIR" run uv:tools:install
