# dot_claude/settings.json の permissions.allow を Codex execpolicy へ移植したもの。
# 副作用のない読み取り系コマンドだけを対象にし、安全に prefix で表現できないものは
# 移植せず除外する:
# - Bash(curl:http://localhost*) … execpolicy の prefix_rule は引数の部分一致
#   (http://localhost の後ろの可変ポート) を表現できない。素の "curl" を許可すると
#   Claude 側より広い許可になってしまうため見送る。
# - Bash(rtk:*) … rtk は Claude Code 用のトークン圧縮プロキシで Codex では想定外。
#   意図的に許可しない (デフォルトの承認フローに任せる)。
# - Bash(gh api:*) … `gh api` は --method でリクエストの動詞を任意に変えられ、
#   prefix_rule では GET のみに絞り込めない (例: `gh api --method DELETE ...` も
#   同じ prefix にマッチしてしまう)。副作用のある呼び出しまで allow してしまうため
#   移植せず、デフォルトの承認フローに任せる。
# ファイル読み取りの deny (.env 等) は execpolicy の対象外 (コマンド実行のみを扱う) なので
# ここには含めない。
#
# herdr は agent/pane/tab/workspace/session 配下に破壊的操作 (close/rename/send-keys/
# delete 等) や別ペインへの入力送信 (send-keys/prompt) を持つサブコマンドが混在する。
# 一括で allow すると `herdr pane close`・`herdr agent send-keys`・`herdr session delete`
# のようなコマンドまで無承認で実行できてしまうため、閲覧・状態確認系のサブコマンドだけを
# 個別に列挙する。`herdr terminal` は attach --takeover 等でターミナルを乗っ取れるため
# 対象外とする。

prefix_rule(
    pattern = ["base64"],
    decision = "allow",
    justification = "base64 はエンコード/デコードのみで副作用がない",
    match = ["base64 -d file.txt"],
)

prefix_rule(
    pattern = ["go", "test"],
    decision = "allow",
    justification = "テスト実行のみ",
    match = ["go test ./..."],
)

prefix_rule(
    pattern = ["git", ["status", "diff", "log", "show"]],
    decision = "allow",
    justification = "読み取り専用の git サブコマンドのみ",
    match = ["git status", "git diff HEAD", "git log -1", "git show HEAD"],
    not_match = ["git push", "git commit"],
)

prefix_rule(
    pattern = ["git", "branch", ["--list", "--show-current"]],
    decision = "allow",
    justification = "git branch は -D 等で削除もできるため、閲覧系オプション指定時のみ許可する",
    match = ["git branch --list", "git branch --show-current"],
    not_match = ["git branch -D foo", "git branch"],
)

prefix_rule(
    pattern = ["gh", "pr", ["view", "list", "diff", "checks"]],
    decision = "allow",
    justification = "PR の閲覧のみ",
    match = ["gh pr view 1", "gh pr list", "gh pr diff 1", "gh pr checks 1"],
)

prefix_rule(
    pattern = ["gh", "issue", ["view", "list"]],
    decision = "allow",
    justification = "issue の閲覧のみ",
    match = ["gh issue view 1", "gh issue list"],
)

prefix_rule(
    pattern = ["gh", "repo", "view"],
    decision = "allow",
    justification = "repo の閲覧のみ",
    match = ["gh repo view"],
)

prefix_rule(
    pattern = ["gh", "run", ["view", "list"]],
    decision = "allow",
    justification = "CI run の閲覧のみ",
    match = ["gh run view 1", "gh run list"],
)

prefix_rule(
    pattern = ["gh", "search"],
    decision = "allow",
    justification = "GitHub 横断検索のみ",
    match = ["gh search prs --repo 0ta2/dots"],
)

prefix_rule(
    pattern = ["herdr", "agent", ["list", "get", "read", "explain"]],
    decision = "allow",
    justification = "herdr agent の閲覧・状態確認のみ (send-keys/prompt/rename等の操作は対象外)",
    match = ["herdr agent list", "herdr agent get reviewer", "herdr agent read reviewer"],
    not_match = ["herdr agent send-keys reviewer enter", "herdr agent prompt reviewer hi"],
)

prefix_rule(
    pattern = ["herdr", "pane", ["list", "current", "get", "layout", "process-info", "neighbor", "edges", "read"]],
    decision = "allow",
    justification = "herdr pane の閲覧のみ (close/split/send-keys等の操作は対象外)",
    match = ["herdr pane list", "herdr pane layout --current", "herdr pane read foo"],
    not_match = ["herdr pane close foo", "herdr pane send-keys foo enter"],
)

prefix_rule(
    pattern = ["herdr", "tab", ["list", "get"]],
    decision = "allow",
    justification = "herdr tab の閲覧のみ",
    match = ["herdr tab list", "herdr tab get foo"],
    not_match = ["herdr tab close foo"],
)

prefix_rule(
    pattern = ["herdr", "workspace", ["list", "get"]],
    decision = "allow",
    justification = "herdr workspace の閲覧のみ",
    match = ["herdr workspace list", "herdr workspace get foo"],
    not_match = ["herdr workspace close foo"],
)

prefix_rule(
    pattern = ["herdr", "session", "list"],
    decision = "allow",
    justification = "herdr session の閲覧のみ (attach/stop/delete は対象外)",
    match = ["herdr session list"],
    not_match = ["herdr session delete foo"],
)

prefix_rule(
    pattern = ["herdr", "notification", "show"],
    decision = "allow",
    justification = "herdr notification の閲覧のみ",
    match = ["herdr notification show"],
)

prefix_rule(
    pattern = ["herdr", "status"],
    decision = "allow",
    justification = "herdr の状態確認のみ",
    match = ["herdr status"],
)

prefix_rule(
    pattern = ["herdr", "worktree", ["list", "create", "open"]],
    decision = "allow",
    justification = "herdr worktree の閲覧・作成・オープンのみ (削除系は対象外)",
    match = ["herdr worktree list", "herdr worktree create foo", "herdr worktree open foo"],
    not_match = ["herdr worktree remove foo"],
)
