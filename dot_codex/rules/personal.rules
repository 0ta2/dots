# dot_claude/settings.json の permissions.allow を Codex execpolicy へ移植したもの。
# 副作用のない読み取り系コマンドだけを対象にし、安全に prefix で表現できないものは
# 移植せず除外する:
# - Bash(curl:http://localhost*) … execpolicy の prefix_rule は引数の部分一致
#   (http://localhost の後ろの可変ポート) を表現できない。素の "curl" を許可すると
#   Claude 側より広い許可になってしまうため見送る。
# - Bash(rtk:*) … rtk は Claude Code 用のトークン圧縮プロキシで Codex では想定外。
#   意図的に許可しない (デフォルトの承認フローに任せる)。
# ファイル読み取りの deny (.env 等) は execpolicy の対象外 (コマンド実行のみを扱う) なので
# ここには含めない。

prefix_rule(
    pattern = ["base64"],
    decision = "allow",
    justification = "base64 はエンコード/デコードのみで副作用がない",
    match = ["base64 -d file.txt"],
)

prefix_rule(
    pattern = ["go", "test"],
    decision = "allow",
    justification = "テスト実行のみ",
    match = ["go test ./..."],
)

prefix_rule(
    pattern = ["git", ["status", "diff", "log", "branch", "show"]],
    decision = "allow",
    justification = "読み取り専用の git サブコマンドのみ",
    match = ["git status", "git diff HEAD", "git log -1", "git branch", "git show HEAD"],
    not_match = ["git push", "git commit"],
)

prefix_rule(
    pattern = ["gh", "pr", ["view", "list", "diff", "checks"]],
    decision = "allow",
    justification = "PR の閲覧のみ",
    match = ["gh pr view 1", "gh pr list", "gh pr diff 1", "gh pr checks 1"],
)

prefix_rule(
    pattern = ["gh", "issue", ["view", "list"]],
    decision = "allow",
    justification = "issue の閲覧のみ",
    match = ["gh issue view 1", "gh issue list"],
)

prefix_rule(
    pattern = ["gh", "repo", "view"],
    decision = "allow",
    justification = "repo の閲覧のみ",
    match = ["gh repo view"],
)

prefix_rule(
    pattern = ["gh", "run", ["view", "list"]],
    decision = "allow",
    justification = "CI run の閲覧のみ",
    match = ["gh run view 1", "gh run list"],
)

prefix_rule(
    pattern = ["gh", "api"],
    decision = "allow",
    justification = "GitHub API 呼び出し (gh の認証スコープの範囲に限られる)",
    match = ["gh api repos/0ta2/dots"],
)

prefix_rule(
    pattern = ["gh", "search"],
    decision = "allow",
    justification = "GitHub 横断検索のみ",
    match = ["gh search prs --repo 0ta2/dots"],
)

prefix_rule(
    pattern = [
        "herdr",
        [
            "agent",
            "pane",
            "tab",
            "workspace",
            "session",
            "terminal",
            "notification",
            "status",
        ],
    ],
    decision = "allow",
    justification = "herdr の操作系サブコマンド",
    match = ["herdr agent list", "herdr pane list", "herdr status"],
)

prefix_rule(
    pattern = ["herdr", "worktree", ["list", "create", "open"]],
    decision = "allow",
    justification = "herdr worktree の閲覧・作成・オープンのみ (削除系は対象外)",
    match = ["herdr worktree list", "herdr worktree create foo", "herdr worktree open foo"],
    not_match = ["herdr worktree remove foo"],
)
